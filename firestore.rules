rules_version = '2';

// Paste this whole file into:
//   Firebase console -> Build -> Firestore Database -> Rules -> Publish
//
// IMPORTANT: the address on the isAdmin() line must match exactly the
// admin user you created under Authentication -> Users, and the
// adminEmail in firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'admin@pickljay.local';
    }
    function signedIn() {
      return request.auth != null;
    }
    function scoreOk(v) {
      return v is int && v >= 0 && v <= 99;
    }

    // The tournament everyone reads. Only the teacher may change it.
    match /tournaments/{slug} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // The teacher's full working copy, so signing in on another
    // device restores everything. Never readable by students.
    match /adminState/{slug} {
      allow read, write: if isAdmin();
    }

    // Results posted by a team on scoring duty. Anyone signed in may
    // send one; only the teacher reads the queue and clears it.
    // Nothing here changes the tournament by itself.
    match /results/{rid} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.by == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(
             ['slug','gameIdx','teamIdx','sa','sb','by','updatedAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.gameIdx is int
        && request.resource.data.gameIdx >= 0
        && request.resource.data.gameIdx < 4096
        && request.resource.data.teamIdx is int
        && scoreOk(request.resource.data.sa)
        && scoreOk(request.resource.data.sb);
      allow delete: if isAdmin();
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
